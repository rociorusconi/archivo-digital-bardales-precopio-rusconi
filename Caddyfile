# HTTPS reverse proxy in front of the application.
# DOMAIN comes from the .env on the server (e.g. archivo-digital-unsam.duckdns.org). Caddy gets
# and renews the Let's Encrypt certificate by itself; it needs ports 80 and 443 open.
# Without DOMAIN it serves https://localhost with a local certificate (to try it on your machine).
{$DOMAIN} {
	reverse_proxy app:8080
}
